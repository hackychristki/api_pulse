<dl id="<%= dom_id monitored_api %>" class="details-list">
  <div>
    <dt>Name</dt>
    <dd><%= monitored_api.name %></dd>
  </div>
  <div>
    <dt>URL</dt>
    <dd><%= link_to monitored_api.url, monitored_api.url, target: "_blank", rel: "noopener" %></dd>
  </div>
  <div>
    <dt>Erwarteter Status</dt>
    <dd><%= monitored_api.expected_status %></dd>
  </div>
</dl>
